rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Health record uploads — each user can only read/write their own folder.
    match /records/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Profile photo uploaded at sign-up — each user can only read/write their own file.
    match /avatars/{fileName} {
      allow read, write: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }

    // Chat attachments (documents shared with a doctor, pharmacist, or support) —
    // any signed-in participant in that chat thread can read/write to it.
    match /chat_attachments/{chatId}/{allPaths=**} {
      allow read, write: if request.auth != null && chatId.matches('.*' + request.auth.uid + '.*');
    }
  }
}
